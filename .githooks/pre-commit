#!/bin/sh
# pre-commit：只对本次暂存的文件跑对应快检查（后端 ruff / 前端 eslint），
# 能自动修的直接修；修完拦下这次提交，让你确认后再 add + commit。
#
# 设计取舍：
#   - 只跑"秒级"检查。tsc、单测、E2E 留给 CI —— hook 一慢，大家就会用 --no-verify 绕过，等于没有。
#   - 前端只查本次改动的文件，不整仓全量。
#   - 后端 ruff check --fix + ruff format 是全量但毫秒级，直接跑。
#   - 前端一律 npx --no-install：只认 frontend/node_modules 里已装的版本，不联网下载。
#
# 启用（每个 clone 执行一次；Linux/macOS 首次可能还需 chmod +x .githooks/pre-commit）：
#   git config core.hooksPath .githooks
#
# 跳过单次检查：git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# —— 后端：改了 .py 就跑 ruff（先自动修，后面的改动检测决定是否拦下）——
if printf '%s\n' "$staged" | grep -qE '\.py$'; then
    echo "[pre-commit] ruff check --fix / ruff format（后端）"
    uv run ruff check --fix . || fail=1
    uv run ruff format . || fail=1
fi

# —— 前端：改了 frontend 下的源码就跑 eslint（只查暂存文件，带 --fix）——
fe=$(printf '%s\n' "$staged" | grep -E '^frontend/.*\.(ts|tsx|js|jsx|mjs|cjs)$' || true)
if [ -n "$fe" ]; then
    echo "[pre-commit] eslint --fix（前端，仅暂存文件）"
    files=$(printf '%s\n' "$fe" | sed 's|^frontend/||' | tr '\n' ' ')
    (cd frontend && npx --no-install eslint --fix $files) || fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "[pre-commit] 检查未通过，提交已阻止（确认无误可用 git commit --no-verify 跳过）"
    exit 1
fi

# —— 自动修复改动了工作树：那些改动还没进暂存区，拦下这次提交让人确认后重新 add ——
if ! git diff --quiet -- $staged; then
    echo "[pre-commit] 已自动修复格式/lint，改动尚未暂存 —— 请 git add 后重新提交"
    git --no-pager diff --stat -- $staged
    exit 1
fi

exit 0
